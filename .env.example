# Environment Variables — Sequential Candle Patterns
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# The .env file is already in .gitignore.

# ── Dashboard ──────────────────────────────────────────────────────────────────
# Host and port for the Dash web server (default: 127.0.0.1:8050)
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Set to 1 to enable Dash debug mode (hot reload, verbose errors)
DASH_DEBUG=0

# ── Email Alerts (optional) ────────────────────────────────────────────────────
# SMTP settings for sending alert notifications via email.
# Leave blank to disable email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_ADDRESS=
ALERT_TO_ADDRESS=

# ── Webhook Alerts (optional) ─────────────────────────────────────────────────
# URL to receive POST requests when a pattern alert fires.
# Leave blank to disable webhook alerts.
WEBHOOK_URL=

# ── Data Storage ──────────────────────────────────────────────────────────────
# Path to the SQLite database file (default: data/candle_patterns.db)
DB_PATH=data/candle_patterns.db

# Path to the alerts database (default: data/alerts.db)
ALERTS_DB_PATH=data/alerts.db

# ── Yahoo Finance ─────────────────────────────────────────────────────────────
# Cache TTL in seconds for Yahoo Finance data (default: 300 = 5 minutes)
YFINANCE_CACHE_TTL=300

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
